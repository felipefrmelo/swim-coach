SWIM_COACH_ENVIRONMENT=development
SWIM_COACH_HOST=0.0.0.0
SWIM_COACH_PORT=8000
SWIM_COACH_LOG_LEVEL=INFO
SWIM_COACH_DATABASE_URL=postgresql://swim_coach:local_only@postgres:5432/swim_coach
SWIM_COACH_API_HOST_PORT=18000
SWIM_COACH_POSTGRES_HOST_PORT=55432
SWIM_COACH_WEB_HOST_PORT=14173
POSTGRES_DB=swim_coach
POSTGRES_USER=swim_coach
POSTGRES_PASSWORD=local_only

# P00 spike inputs. Leave blank unless running the documented manual probes.
# OAuth metadata is advertised only when both issuer and resource are HTTPS URLs.
SWIM_COACH_PUBLIC_BASE_URL=
SWIM_COACH_OAUTH_ISSUER=
SWIM_COACH_OAUTH_RESOURCE=
GARMIN_EMAIL=
