SWIM_COACH_ENVIRONMENT=development
SWIM_COACH_HOST=0.0.0.0
SWIM_COACH_PORT=8000
SWIM_COACH_LOG_LEVEL=INFO
SWIM_COACH_DATABASE_URL=postgresql://swim_coach:local_only@postgres:5432/swim_coach
SWIM_COACH_API_HOST_PORT=18000
SWIM_COACH_POSTGRES_HOST_PORT=55432
SWIM_COACH_WEB_HOST_PORT=14173
SWIM_COACH_PWA_BASE_URL=http://127.0.0.1:14173
POSTGRES_DB=swim_coach
POSTGRES_USER=swim_coach
POSTGRES_PASSWORD=local_only

# P00 spike inputs. Leave blank unless running the documented manual probes.
# Configure issuer and resource together. Issuer is always HTTPS; resource may
# use HTTP only for loopback development behind Secure MCP Tunnel.
SWIM_COACH_PUBLIC_BASE_URL=
SWIM_COACH_OAUTH_ISSUER=
SWIM_COACH_OAUTH_RESOURCE=
SWIM_COACH_OAUTH_JWKS_CACHE_SECONDS=300
GARMIN_EMAIL=

# P01 PWA authentication. OIDC uses Authorization Code + PKCE through the BFF.
# Keep the client secret blank for a public client; never commit a real value.
SWIM_COACH_OIDC_ISSUER=
SWIM_COACH_OIDC_CLIENT_ID=
SWIM_COACH_OIDC_CLIENT_SECRET=
SWIM_COACH_AUTH_ALLOWED_EMAILS=local-swimmer@example.test
SWIM_COACH_AUTH_ALLOWED_SUBJECTS=

# Explicitly local-only; Settings rejects this in production.
SWIM_COACH_DEV_AUTH_ENABLED=true
SWIM_COACH_DEV_AUTH_EMAIL=local-swimmer@example.test

# P02 Garmin read-only integration. Generate a 32-byte key locally, encode it
# with URL-safe base64 and inject it through the runtime secret mechanism.
# Example shape only: v1:<base64url-encoded-32-byte-key>
SWIM_COACH_GARMIN_MASTER_KEYS=
SWIM_COACH_GARMIN_ACTIVE_KEY_VERSION=
SWIM_COACH_GARMIN_SYNC_LOOKBACK_DAYS=90
SWIM_COACH_GARMIN_SYNC_OVERLAP_SECONDS=172800

# P03 immutable FIT artifacts. In Compose this is a shared named volume used
# by the API and worker; override only with a private persistent directory.
SWIM_COACH_ACTIVITY_STORAGE_PATH=.swim-coach-data/artifacts
