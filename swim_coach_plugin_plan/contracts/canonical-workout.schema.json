{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swim-coach.local/schemas/canonical-workout/1.0.json",
  "title": "Swim Coach Canonical Pool Workout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "sport",
    "pool_length_m",
    "purpose",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "sport": {
      "const": "POOL_SWIMMING"
    },
    "pool_length_m": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "purpose": {
      "type": "string",
      "enum": [
        "TECHNIQUE",
        "BASE",
        "ENDURANCE",
        "THRESHOLD",
        "SPEED",
        "RECOVERY",
        "TEST",
        "MIXED"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "$ref": "#/$defs/repeat"
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "end_condition"
      ],
      "properties": {
        "type": {
          "const": "step"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "step_role": {
          "type": "string",
          "enum": [
            "WARMUP",
            "WORK",
            "RECOVERY",
            "REST",
            "COOLDOWN",
            "DRILL",
            "OTHER"
          ],
          "default": "WORK"
        },
        "end_condition": {
          "$ref": "#/$defs/endCondition"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "stroke": {
          "$ref": "#/$defs/stroke"
        },
        "intensity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "EASY",
            "MODERATE",
            "TEMPO",
            "THRESHOLD",
            "FAST",
            "MAX",
            "CUSTOM",
            null
          ]
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BOARD",
              "FINS",
              "PADDLES",
              "PULL_BUOY",
              "SNORKEL",
              "NONE"
            ]
          },
          "uniqueItems": true
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "repetitions",
        "children"
      ],
      "properties": {
        "type": {
          "const": "repeat"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "endCondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "meters"
          ],
          "properties": {
            "type": {
              "const": "distance"
            },
            "meters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "time"
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 86400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "lap_button"
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "min_seconds_per_100m",
            "max_seconds_per_100m"
          ],
          "properties": {
            "type": {
              "const": "pace_range"
            },
            "min_seconds_per_100m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_seconds_per_100m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "min",
            "max"
          ],
          "properties": {
            "type": {
              "const": "rpe"
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "zone"
          ],
          "properties": {
            "type": {
              "const": "zone"
            },
            "zone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      ],
      "default": {
        "type": "none"
      }
    },
    "stroke": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "freestyle",
                "backstroke",
                "breaststroke",
                "butterfly",
                "mixed",
                "choice",
                "kick"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "drill"
          ],
          "properties": {
            "type": {
              "const": "drill"
            },
            "drill": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "side": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "LEFT",
                "RIGHT",
                "ALTERNATE",
                null
              ]
            }
          }
        }
      ],
      "default": {
        "type": "freestyle"
      }
    }
  },
  "x-domain-invariants": [
    "Every distance end condition must be divisible by pool_length_m.",
    "Pace range min must be <= max.",
    "RPE min must be <= max.",
    "A revision used by a proposal is immutable and addressed by content hash.",
    "Device/provider capability validation is performed after canonical validation."
  ]
}
